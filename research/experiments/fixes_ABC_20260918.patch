+def gutter_frame_cut(g, gutter, frame=None):
+    """方案A：格框線切割。回傳切完的 gutter 遮罩（GFC_ON 為假時原樣回）。"""
+    if not GFC_ON or not gutter.any():
+        return gutter
+    H, W = gutter.shape
+    lh, lv = frame_line_mask(g)
+    raw = ((lh | lv) > 0).astype(np.uint8)       # 真的偵測到的框線
+    if GFC_CLOSE_FRAC > 0:                       # 沿線方向閉合＝補上被出血人物打斷的框線
