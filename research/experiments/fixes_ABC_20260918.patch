+
+    fr = _dil(raw, GFC_DILATE) | _dil(bridge, GFC_BRIDGE_DILATE)   # 真線膨脹、橋不膨脹
+    cutm = (gutter & (fr == 0)).astype(np.uint8)
+    n_, lb_, st_, _ = cv2.connectedComponentsWithStats(cutm, 8)
+    if n_ <= 1:
+        return gutter
+    dist = cv2.distanceTransform(cutm, cv2.DIST_L2, 5) if GFC_KEEP_THIN else None
+    keep = np.zeros((H, W), bool)
+    # 「碰得到頁邊」的容差要涵蓋框線膨脹：頁緣本身常是一條長暗線（掃描邊/最外格框），
+    # 膨脹後會把貼邊那幾 px 白吃掉 ⇒ 用 2px 判定會把整片頁邊留白誤判成不碰邊（demo02 頂緣實測）。
+    etol = GFC_DILATE + 3
+    for i in range(1, n_):
+        x, y, w_, h_ = st_[i, 0], st_[i, 1], st_[i, 2], st_[i, 3]
+        if x <= etol or y <= etol or x + w_ >= W - etol or y + h_ >= H - etol:
+            keep |= (lb_ == i)                   # 仍碰得到頁邊＝真留白
+            continue
