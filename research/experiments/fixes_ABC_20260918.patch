+def line_art_density(g, frame, seg=None, k=None, bubble=None):
+    """逐「格框線圍出的區域」量線稿密度：窗內**同區域**的非白比例（跨框的內容不計）。
+
+    回傳 float32 密度圖；沒被任何夠大區域涵蓋的像素＝0（當成空白、不否決）。
+    """
+    k = GUTTER_TEXTURE_WIN if k is None else k
+    H, W = g.shape
+    fr = np.zeros((H, W), np.uint8) if frame is None else (np.asarray(frame) > 0).astype(np.uint8)
+    if GUTTER_TEXTURE_FRDIL > 0 and fr.any():
+        fr = cv2.dilate(fr, np.ones((GUTTER_TEXTURE_FRDIL,) * 2, np.uint8))
+    frb = fr > 0
+    content = (g < WHITE_TH) & ~frb
+    if seg is not None and GUTTER_TEXTURE_SEGDIL > 0:
+        # 文字筆畫不算線稿：泡外旁白/狀聲詞的白底若被當成畫面就不填 ⇒ 白泡指標惡化
+        content &= ~(cv2.dilate(seg.astype(np.uint8),
+                                np.ones((GUTTER_TEXTURE_SEGDIL,) * 2, np.uint8)) > 0)
+    if bubble is not None and GUTTER_TEXTURE_BUBDIL > 0 and np.any(bubble):
+        # 泡的輪廓線不算線稿：否則泡外那圈白的密度爆表 ⇒ 不填 ⇒ 成品出現沿泡邊的灰暈
+        content &= ~(cv2.dilate(np.asarray(bubble).astype(np.uint8),
+                                np.ones((GUTTER_TEXTURE_BUBDIL,) * 2, np.uint8)) > 0)
+    cf = content.astype(np.float32)
+    n, rlab, rst, _ = cv2.connectedComponentsWithStats((~frb).astype(np.uint8), 8)
+    dens = np.zeros((H, W), np.float32)
+    for i in range(1, n):
+        if int(rst[i, cv2.CC_STAT_AREA]) < GUTTER_TEXTURE_REGMIN * g.size:
+            continue
+        x, y, cw, ch = rst[i, 0], rst[i, 1], rst[i, 2], rst[i, 3]
+        x0, y0 = max(0, x - k), max(0, y - k)
+        x1, y1 = min(W, x + cw + k), min(H, y + ch + k)
+        reg = (rlab[y0:y1, x0:x1] == i).astype(np.float32)
+        num = cv2.boxFilter(cf[y0:y1, x0:x1] * reg, -1, (k, k), normalize=True,
+                            borderType=cv2.BORDER_CONSTANT)
+        den = cv2.boxFilter(reg, -1, (k, k), normalize=True, borderType=cv2.BORDER_CONSTANT)
+        m = reg > 0
+        dens[y0:y1, x0:x1][m] = (num / np.maximum(den, 1e-3))[m]
+    return dens
+
