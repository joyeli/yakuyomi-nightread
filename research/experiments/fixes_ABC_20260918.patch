+        return gutter                            # 全切光＝框線偵測異常，退回現況
+    if GFC_DILATE > 0:                           # 框線帶回填：否則格框旁留一圈白
+        kd = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, ((GFC_DILATE + 2) * 2 + 1,) * 2)
+        keep |= gutter & (fr > 0) & (cv2.dilate(keep.astype(np.uint8), kd) > 0)
+    return keep
