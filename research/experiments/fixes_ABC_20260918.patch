+def texture_veto(fill, g, frame, seg=None, dens=None, bubble=None):
+    """方案C：把「線稿密度 ≥ GUTTER_TEXTURE_TH」的像素從留白填色裡剔掉（預設關）。"""
+    if GUTTER_TEXTURE_TH <= 0 or not np.any(fill):
+        return fill
+    if dens is None:
+        dens = line_art_density(g, frame, seg, bubble=bubble)
+    veto = fill & (dens >= GUTTER_TEXTURE_TH)
+    if GUTTER_TEXTURE_MIN > 0 and veto.any():
+        n, vlab, vst, _ = cv2.connectedComponentsWithStats(veto.astype(np.uint8), 8)
+        ids = [i for i in range(1, n) if int(vst[i, cv2.CC_STAT_AREA]) >= GUTTER_TEXTURE_MIN]
+        veto = np.isin(vlab, ids) if ids else np.zeros_like(veto)
+    if GUTTER_TEXTURE_PAD > 0 and veto.any():
+        kk = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (GUTTER_TEXTURE_PAD * 2 + 1,) * 2)
+        veto = cv2.dilate(veto.astype(np.uint8), kk) > 0
+    return fill & ~veto
